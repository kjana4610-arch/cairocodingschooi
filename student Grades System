#include <iostream>
using namespace std;

class Student
{
private:
    string name;
    int id;
    double grade1;
    double grade2;
    double grade3;

public:

    void addStudent()
    {
        cout << "Enter Student Name: ";
        cin >> name;

        cout << "Enter Student ID: ";
        cin >> id;

        cout << "Enter Grade 1: ";
        cin >> grade1;

        cout << "Enter Grade 2: ";
        cin >> grade2;

        cout << "Enter Grade 3: ";
        cin >> grade3;
    }

    double getAverage()
    {
        return (grade1 + grade2 + grade3) / 3;
    }

    void showStudent()
    {
        double average = getAverage();

        cout << "\n===== STUDENT INFORMATION =====\n";
        cout << "Name: " << name << endl;
        cout << "ID: " << id << endl;
        cout << "Grade 1: " << grade1 << endl;
        cout << "Grade 2: " << grade2 << endl;
        cout << "Grade 3: " << grade3 << endl;
        cout << "Average: " << average << endl;

        if (average >= 50)
            cout << "Result: Pass\n";
        else
            cout << "Result: Fail\n";
    }
};

int main()
{
    Student student;

    student.addStudent();
    student.showStudent();

    return 0;
}
